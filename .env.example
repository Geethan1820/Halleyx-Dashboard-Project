# Copy to .env in the project root (optional — defaults work for local Docker)
# cp .env.example .env

# Backend
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend — URL the browser uses to reach the API (host machine, not Docker DNS)
VITE_API_URL=http://localhost:3000
